// 主界面销毁函数
static void book_view_destroy(void)
{
	// 清理资源
	if (book_view.screen != NULL) {
		lv_obj_del(book_view.screen);
		book_view.screen = NULL;
	}
}

static void book_view_hide(void)
{
	if (book_view.screen != NULL) {
		// 隐藏当前屏幕
		lv_obj_add_flag(book_view.screen, LV_OBJ_FLAG_HIDDEN);
	}
}

static void book_view_show(void)
{
	if (book_view.screen != NULL) {
		// 显示当前屏幕
		lv_obj_clear_flag(book_view.screen, LV_OBJ_FLAG_HIDDEN);
	}
}

static void screen_event_handler(lv_event_t * e)
{
	lv_event_code_t code = lv_event_get_code(e);
	lv_indev_t * indev = lv_indev_get_act();
	if(indev == NULL) return;

	lv_point_t point;
	lv_indev_get_point(indev, &point);

	if (code == LV_EVENT_CLICKED) {
		if (point.x > lv_display_get_horizontal_resolution(NULL) / 2) {
			book_view_printf("next page.\n");
//			if (g_book_ui.current_page < g_book_ui.total_pages - 1) {
//				g_book_ui.current_page++;
//				update_page_content();
//			}
		} else {
			book_view_printf("pre page.\n");
//			if (g_book_ui.current_page > 0) {
//				g_book_ui.current_page--;
//				update_page_content();
//			}
		}
	}
}

// 事件回调函数
static void book_view_event_cb(lv_event_t *e)
{
	lv_event_code_t code = lv_event_get_code(e);

	switch(code) {
		case LV_EVENT_SCREEN_LOADED:
			// 屏幕加载完成后的处理
			break;

		case LV_EVENT_SCREEN_UNLOADED:
			// 屏幕卸载时的处理
			break;

		default:
			break;
	}
}

#if 0
static void add_new_page(unsigned char *start, unsigned char *next)
{
    p_page_desc_t new_page = malloc(sizeof(page_desc_t));
    if (!new_page) {
        return;
    }

    new_page->page_start = start;
    new_page->next_page_start = next;
    new_page->prev_page = NULL;
    new_page->next_page = NULL;

    if (!g_book_ui.pages) {
        g_book_ui.pages = new_page;
    } else {
        p_page_desc_t page = g_book_ui.pages;
        while (page->next_page) {
            page = page->next_page;
        }
        page->next_page = new_page;
        new_page->prev_page = page;
    }
    g_book_ui.total_pages++;
}

static void calculate_pages(void)
{
    unsigned char *cur_pos = g_book_ui.file_map;
    unsigned char *page_start = cur_pos;
    int x = 0;
    int y = 24;
    uint32_t code;
    int len;

    while (cur_pos < g_book_ui.file_end) {
        len = GetCharFromEncodingFile(cur_pos, g_book_ui.file_end, &code);
        if (len <= 0) break;

        if (code == '\n') {
            x = 0;
            y += 24;
            if (y > 460) { // 页面高度限制
                add_new_page(page_start, cur_pos);
                page_start = cur_pos + len;
                y = 24;
            }
            cur_pos += len;
            continue;
        }
        else if (code == '\r') {
            cur_pos += len;
            continue;
        }

        if (x + 24 > 780) { // 页面宽度限制
            x = 0;
            y += 24;
            if (y > 460) { // 页面高度限制
                add_new_page(page_start, cur_pos);
                page_start = cur_pos;
                y = 24;
            }
        }

        x += 24;
        cur_pos += len;
    }

    // 添加最后一页
    if (page_start < cur_pos) {
        add_new_page(page_start, cur_pos);
    }
}

static void render_char(int x, int y, uint32_t code)
{
    T_FontBitMap font_bitmap;
    int ret;

    // 获取字体位图
    ret = g_book_ui.font_opr->GetFontBitmap(code, &font_bitmap);
    if (ret) {
        printf("Get font bitmap failed\n");
        return;
    }

    // 在画布上绘制字符
    for (int i = font_bitmap.iYTop; i < font_bitmap.iYMax; i++) {
        for (int j = font_bitmap.iXLeft; j < font_bitmap.iXMax; j++) {
            int index = (i - font_bitmap.iYTop) * font_bitmap.iPitch + (j - font_bitmap.iXLeft) / 8;
            int bit = 7 - (j - font_bitmap.iXLeft) % 8;
            
            if (font_bitmap.pucBuffer[index] & (1 << bit)) {
                lv_canvas_set_px(g_book_ui.canvas, x + j, y + i, lv_color_make(0x51, 0x44, 0x38));
            }
        }
    }
}

static void update_page_content(void)
{
    if (!g_book_ui.cur_page) {
        return;
    }

    size_t len = g_book_ui.cur_page->next_page_start - g_book_ui.cur_page->page_start;
    if(len <= 0) {
        return;
    }

    // 分配临时缓冲区来存储页面内容
    char* page_text = (char*)malloc(len + 1);
    if (!page_text) {
        return;
    }

    // 复制当前页面内容
    memcpy(page_text, g_book_ui.cur_page->page_start, len);
    page_text[len] = '\0';

    // 更新标签文本
    lv_label_set_text(g_book_ui.label, page_text);
    free(page_text);

    // 更新页码
    int current_page = 1;
    p_page_desc_t page = g_book_ui.pages;
    while (page && page != g_book_ui.cur_page) {
        current_page++;
        page = page->next_page;
    }

    lv_label_set_text_fmt(g_book_ui.page_label, "%d / %d", current_page, g_book_ui.total_pages);
}
#endif

